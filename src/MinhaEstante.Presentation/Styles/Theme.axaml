<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- Recursos dependentes do tema (claro/escuro) -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0A0E27" Offset="0" />
        <GradientStop Color="#141B36" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SidebarBrush" Color="#0B1024" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#131B30" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA4BD" />
      <SolidColorBrush x:Key="CardCoverBrush" Color="#0A0E27" />
      <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1A2340" />
      <SolidColorBrush x:Key="ButtonCardBrush" Color="#1C2740" />
      <SolidColorBrush x:Key="ButtonCardHoverBrush" Color="#263448" />
      <SolidColorBrush x:Key="ButtonCardPressedBrush" Color="#2E3E55" />
      <SolidColorBrush x:Key="NavHoverBrush" Color="#14FFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#F4F6FB" Offset="0" />
        <GradientStop Color="#E4EAF4" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14000000" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2433" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6478" />
      <SolidColorBrush x:Key="CardCoverBrush" Color="#E9EDF5" />
      <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E4EAF4" />
      <SolidColorBrush x:Key="ButtonCardBrush" Color="#E9EDF5" />
      <SolidColorBrush x:Key="ButtonCardHoverBrush" Color="#D8DFEC" />
      <SolidColorBrush x:Key="ButtonCardPressedBrush" Color="#C7D0E0" />
      <SolidColorBrush x:Key="NavHoverBrush" Color="#14000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Recursos independentes do tema: cor de destaque (accent) e gradiente de progresso -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="#4FC3F7" />
  <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="#4FC3F7" Offset="0" />
    <GradientStop Color="#9B7BFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Dimensões ajustáveis pelo usuário (tamanho das capas) -->
  <sys:Double x:Key="BookCardWidth">200</sys:Double>
  <sys:Double x:Key="CoverHeight">200</sys:Double>

</ResourceDictionary>