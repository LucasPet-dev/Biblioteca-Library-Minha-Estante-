<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinhaEstante.Presentation.ViewModels"
             xmlns:res="using:MinhaEstante.Presentation.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360"
             x:Class="MinhaEstante.Presentation.Views.ImportView"
             x:DataType="vm:ImportViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="520" Margin="24" HorizontalAlignment="Center">

            <TextBlock Text="{x:Static res:Strings.ImportBook}" FontSize="24" FontWeight="SemiBold" />

            <TextBlock Text="{x:Static res:Strings.ImportSubtitle}"
                       Opacity="0.7" TextWrapping="Wrap" />

            <Button x:Name="BrowseButton" Content="{x:Static res:Strings.SelectFile}" HorizontalAlignment="Stretch" />

            <TextBox Text="{Binding SourcePath}" IsReadOnly="True" Watermark="{x:Static res:Strings.NoFileSelected}" />

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
                <Button Content="{x:Static res:Strings.Import}"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding !IsImporting}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>