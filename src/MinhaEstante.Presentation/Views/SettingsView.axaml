<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinhaEstante.Presentation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="MinhaEstante.Presentation.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Leitor -->
            <StackPanel Spacing="4">
                <TextBlock Text="Leitor" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Preferências de exibição ao abrir um livro." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Zoom padrão" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding DefaultZoom, StringFormat='{}{0:0.00}x'}" />
                        </Grid>
                        <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.05"
                                Value="{Binding DefaultZoom}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Modo de exibição" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding FitModeOptions}"
                                  SelectedIndex="{Binding FitModeIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Aparência -->
            <StackPanel Spacing="4">
                <TextBlock Text="Aparência" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Tema e tamanho das capas." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Tema" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding IsDarkTheme}"
                                      OnContent="Escuro" OffContent="Claro"
                                      HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Tamanho das capas" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding CoverSizeOptions}"
                                  SelectedIndex="{Binding CoverSizeIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Biblioteca -->
            <StackPanel Spacing="4">
                <TextBlock Text="Biblioteca" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Ordenação dos itens da biblioteca." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Ordenação padrão" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding SortOrderOptions}"
                                  SelectedIndex="{Binding SortOrderIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Dados / Armazenamento -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dados / Armazenamento" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Localização dos arquivos e limpeza de cache." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Pasta da biblioteca" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" />
                        <Button x:Name="BrowseFolderButton" Content="Escolher nova pasta..."
                                HorizontalAlignment="Left" />
                        <TextBlock Text="Os dados serão copiados para a nova pasta e aplicados após reiniciar o aplicativo."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Cache" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Content="Limpar cache de páginas" Command="{Binding ClearCacheCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="{Binding StorageStatus}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                </StackPanel>
            </Border>

            <!-- Geral -->
            <StackPanel Spacing="4">
                <TextBlock Text="Geral" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Idioma e comportamento de salvamento." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Idioma" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding LanguageIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Salvar progresso" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding ProgressSaveIntervalOptions}"
                                  SelectedIndex="{Binding ProgressSaveIntervalIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>