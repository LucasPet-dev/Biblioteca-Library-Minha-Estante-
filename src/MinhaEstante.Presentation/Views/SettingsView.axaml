<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinhaEstante.Presentation.ViewModels"
             xmlns:res="using:MinhaEstante.Presentation.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="MinhaEstante.Presentation.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Leitor -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.ReaderSection}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.ReaderSectionSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Static res:Strings.DefaultZoom}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding DefaultZoom, StringFormat='{}{0:0.00}x'}" />
                        </Grid>
                        <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.05"
                                Value="{Binding DefaultZoom}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.FitMode}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding FitModeOptions}"
                                  SelectedIndex="{Binding FitModeIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Aparência -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.AppearanceSection}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.AppearanceSectionSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.Theme}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding IsDarkTheme}"
                                      OnContent="{x:Static res:Strings.ThemeDark}" OffContent="{x:Static res:Strings.ThemeLight}"
                                      HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.CoverSize}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding CoverSizeOptions}"
                                  SelectedIndex="{Binding CoverSizeIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Biblioteca -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SectionLibrary}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.LibrarySortSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.SortOrder}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding SortOrderOptions}"
                                  SelectedIndex="{Binding SortOrderIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Dados / Armazenamento -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.StorageSection}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.StorageSectionSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.LibraryFolder}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" />
                        <Button x:Name="BrowseFolderButton" Content="{x:Static res:Strings.BrowseFolder}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static res:Strings.MoveDataHint}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.Cache}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Content="{x:Static res:Strings.ClearPageCache}" Command="{Binding ClearCacheCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="{Binding StorageStatus}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                </StackPanel>
            </Border>

            <!-- Geral -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.GeneralSection}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.GeneralSectionSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="settingscard">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.Language}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding LanguageIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.SaveProgress}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding ProgressSaveIntervalOptions}"
                                  SelectedIndex="{Binding ProgressSaveIntervalIndex}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>